# Salin ke .env.local lalu sesuaikan. Semua opsional; nilai di bawah adalah default testnet.

# "testnet" atau "mainnet"
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Kontrak Karcis (event, pass, kampanye, voting)
NEXT_PUBLIC_CONTRACT_ID=pass.karcis.testnet

# Token stablecoin (NEP-141) untuk pembayaran.
# Testnet: usdc.fakes.testnet (siapa pun bisa mint untuk uji coba)
# Mainnet USDC: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
NEXT_PUBLIC_STABLE_TOKEN=usdc.fakes.testnet
NEXT_PUBLIC_STABLE_SYMBOL=USDC

# RPC (opsional)
# NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com

# Kurs tampilan saja (Rupiah per 1 USDC); bukan kurs pasar
NEXT_PUBLIC_IDR_PER_USD=16000
